rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == "luca.mergell@gmail.com" ||
        request.auth.uid == "EcPBJmo8AJdJ9UHTFVmwb0dB8ym2"
      );
    }
    match /bookings/{bookingId} {
      allow create: if true;
      allow get: if true;
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verificationMethod', 'customerEmail'])
      );
      allow list, delete: if isAdmin();
    }
    match /availability/{date} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    match /taken_slots/{slotId} {
      allow get, list, create, update: if true;
      allow delete: if isAdmin();
    }
    match /verification_codes/{email} {
      allow get, list, create, update, delete: if true;
    }
    match /settings/pricing {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    match /promo_codes/{code} {
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }
    match /addons/{addonId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    match /gallery/{itemId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    match /clients/{phoneNumber} {
      allow get, create, update: if true;
      allow list, delete: if isAdmin();
      match /cars/{carId} {
        allow get, list, create, update, delete: if true;
      }
    }
  }
}
